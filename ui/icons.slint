// Icônes vectorielles dessinées pour Plimb Studio (tracés 24×24).

export component Icon {
    in property <string> name;
    in property <brush> color: black;
    in property <length> size: 22px;
    in property <length> thickness: 2px;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.color;
        stroke-width: root.thickness;
        fill: transparent;
        commands: root.name == "menu" ? "M4 7 L20 7 M4 12 L20 12 M4 17 L14 17"
            : root.name == "back" ? "M15 5 L8 12 L15 19 M8 12 L20 12"
            : root.name == "close" ? "M6 6 L18 18 M18 6 L6 18"
            : root.name == "send" ? "M4 11.5 L20 4 L13.5 20 L11 13 Z"
            : root.name == "tune" ? "M4 7 L13 7 M17 7 L20 7 M4 17 L7 17 M11 17 L20 17 M15 4.5 L15 9.5 M9 14.5 L9 19.5"
            : root.name == "download" ? "M12 4 L12 15 M7 10 L12 15 L17 10 M5 20 L19 20"
            : root.name == "trash" ? "M5 7 L19 7 M10 7 L10 4 L14 4 L14 7 M7 7 L8 20 L16 20 L17 7"
            : root.name == "chat" ? "M5 5 L19 5 Q20 5 20 6 L20 15 Q20 16 19 16 L11 16 L7 20 L7 16 L5 16 Q4 16 4 15 L4 6 Q4 5 5 5 Z M8 9.5 L16 9.5 M8 12.5 L13 12.5"
            : root.name == "book" ? "M12 6 Q9 4 4 4.5 L4 18.5 Q9 18 12 20 Q15 18 20 18.5 L20 4.5 Q15 4 12 6 Z M12 6 L12 20"
            : root.name == "drop" ? "M12 3 Q6 10 6 14.5 Q6 20 12 20 Q18 20 18 14.5 Q18 10 12 3 Z M9 15 Q9 17 11 17.5"
            : root.name == "layers" ? "M12 3 L20 7.5 L12 12 L4 7.5 Z M4 12 L12 16.5 L20 12 M4 16.5 L12 21 L20 16.5"
            : root.name == "refresh" ? "M19 12 A7 7 0 1 1 16.9 7 M19 4 L19 8.5 L14.5 8.5"
            : root.name == "image" ? "M4 5 L20 5 L20 19 L4 19 Z M4 16 L9 11 L13 15 L15.5 12.5 L20 17 M15 8.5 L16 8.5"
            : root.name == "external" ? "M13 4 L20 4 L20 11 M20 4 L11 13 M17 14 L17 20 L4 20 L4 7 L10 7"
            : root.name == "plus" ? "M12 5 L12 19 M5 12 L19 12"
            : root.name == "check" ? "M5 12.5 L10 17 L19 7"
            : root.name == "folder" ? "M3 6 L9 6 L11 8 L21 8 L21 19 L3 19 Z"
            : root.name == "save" ? "M5 4 L16 4 L20 8 L20 20 L5 20 Z M8 4 L8 9 L15 9 L15 4 M8 20 L8 14 L17 14 L17 20"
            : root.name == "edit" ? "M4 20 L8 19 L19 8 L16 5 L5 16 Z M14 7 L17 10"
            : root.name == "chevron-right" ? "M9 6 L15 12 L9 18"
            : root.name == "chevron" ? "M6 9 L12 15 L18 9"
            : root.name == "settings" ? "M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5 Z M12 2.5 L12 5.5 M12 18.5 L12 21.5 M2.5 12 L5.5 12 M18.5 12 L21.5 12 M5.3 5.3 L7.4 7.4 M16.6 16.6 L18.7 18.7 M5.3 18.7 L7.4 16.6 M16.6 7.4 L18.7 5.3"
            : root.name == "info" ? "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 11 L12 16.5 M12 7.5 L12 8"
            : root.name == "spark" ? "M12 3 L13.6 10.4 L21 12 L13.6 13.6 L12 21 L10.4 13.6 L3 12 L10.4 10.4 Z"
            : root.name == "stop" ? "M7 7 L17 7 L17 17 L7 17 Z"
            : root.name == "shield" ? "M12 3 L19 6 L19 11.5 Q19 17.5 12 21 Q5 17.5 5 11.5 L5 6 Z M9 12 L11 14 L15 9.5"
            : "M12 4 A8 8 0 1 0 12 20 A8 8 0 1 0 12 4 Z";
    }
}

// Pastille colorée de catégorie (forme organique propre à Plimb).
export component CategoryBadge inherits Rectangle {
    in property <color> tint;
    in property <string> icon;
    in property <length> size: 52px;
    width: size;
    height: size;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.size * 0.32;
        background: @linear-gradient(135deg, root.tint.brighter(0.25) 0%, root.tint.darker(0.15) 100%);
    }

    Icon {
        name: root.icon;
        color: white;
        size: root.size * 0.5;
        thickness: 2px;
    }
}
